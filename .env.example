# ==============================================================================
# Meta Colab - Variables d'Environnement
# ==============================================================================

# Port d'écoute du serveur Node.js (défaut : 3000)
PORT=3000

# Environnement d'exécution : 'development' | 'production' | 'test'
NODE_ENV=development

# URL publique de l'application (utilisée pour les redirections OAuth et les webhooks Meta)
# En local : http://localhost:3000
# En production : https://votre-domaine.com
APP_URL=http://localhost:3000

# Clé secrète de l'application (au moins 32 caractères aléatoires)
# Utilisée pour signer les sessions et chiffrer les jetons d'accès Meta et clés API stockées
APP_SECRET=metacolab_super_secret_encryption_key_change_me_in_prod_32chars!

# Base de données
# MySQL (XAMPP : l'utilisateur root n'a généralement pas de mot de passe)
# Créez d'abord la base ia_agent_studio dans phpMyAdmin.
 postgresql://user:password@localhost:5432/metacolab
DATABASE_URL=mysql://root:@localhost:3306/ia_agent_studio
# Alternative si DATABASE_URL=mysql est déjà utilisé dans votre .env :
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=ia_agent_studio

# --- Fournisseurs d'Intelligence Artificielle ---
# Clé API Google Gemini (recommandé et activé par défaut)
GEMINI_API_KEY=votre_cle_gemini_api_ici

# Clé API OpenAI (facultatif)
OPENAI_API_KEY=

# Clé API xAI Grok (facultatif)
GROK_API_KEY=

# URL d'instance Ollama locale ou distante (ex: http://localhost:11434)
OLLAMA_BASE_URL=

# --- Intégrations Meta (Facebook & Instagram) ---
# Identifiant de votre Meta App créée sur https://developers.facebook.com/
META_APP_ID=
# Clé secrète de votre Meta App
META_APP_SECRET=
# Jeton de vérification des Webhooks Meta
META_WEBHOOK_VERIFY_TOKEN=metacolab_meta_webhook_secret_verify_token

# --- Service d'Emails Transactionnels (SMTP) ---
SMTP_ENABLED=false
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Meta Colab <notifications@metacolab.io>"

# --- Stockage des Médias et Visuels ---
# 'local' pour stockage sur disque (public/uploads), ou 's3' pour AWS S3 / Cloudflare R2 / MinIO
STORAGE_DRIVER=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-3
AWS_BUCKET_NAME=

# --- Comptes Démonstration Pré-initialisés ---
# Mot de passe pour le Super Administrateur (admin@metacolab.io)
DEMO_ADMIN_PASSWORD=AdminMetaColab2026!
# Mot de passe pour le compte utilisateur de test (demo@metacolab.io)
DEMO_USER_PASSWORD=DemoUser2026!
